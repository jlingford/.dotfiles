# basic settings
ui mousemode right select
set bgCol white
# col bychain
col byhet
lighting soft
set sil t
graphics sil width 1

# make selection outline black
graphics sel width 3 col black


# hide side chains, but keep ligands/cofactors visible
sel protein
style sel ball
col sel byhet
hide sel a,s
show sel c

# color chains sequentially (looks better than the default color bychain option)
# col seq chains target acs palette Pastel1-4
# col seq chains target acs palette #f5e0dc:#f2cdcd:#f5c2e7:#cba6f7:#f38ba8:#eba0ac:#fab387:#f9e2af:#a6e3a1:#94e2d5:#89dceb:#74c7ec:#89b4fa:#b4befe:#cdd6f4
# col seq chains target acs palette #f2cdcd:#f5c2e7:#cba6f7:#f38ba8:#eba0ac:#fab387:#f9e2af:#a6e3a1:#94e2d5:#89dceb:#74c7ec:#89b4fa:#b4befe:#cdd6f4
col seq polymers target acs palette #f2cdcd:#f5c2e7:#cba6f7:#f38ba8:#eba0ac:#fab387:#f9e2af:#a6e3a1:#94e2d5:#89dceb:#74c7ec:#89b4fa:#b4befe:#cdd6f4
# col seq polymers target acs palette #89b4fa:#b4befe:#cdd6f4:#f2cdcd:#f5c2e7:#cba6f7:#f38ba8:#eba0ac:#fab387:#f9e2af:#a6e3a1:#94e2d5:#89dceb:#74c7ec
# col seq polymers target acs palette #dce0e8:#e6e9ef:#ccd0da:#bcc0cc:#acb0be:#9ca0b0:#8c8fa1:#7c7f93:#6c6f85:#5c5f77:#4c4f69
# col seq polymers target acs palette #dce0e8:#4c4f69

### plddt colours
# color bfactor palette '0,#c53233:50,#f4c2aa:70,#7ea1f9:90,#3b4dc1'

# style ligands/cofactors as ball and stick
sel ~protein
style sel ball
col sel byel

# # style ligands/cofactors as chunky spheres (pymol like look for cofactors)
# sel ~protein
# size sel atomRadius 1.5
# col sel byel

## style nucleotide ligands with a ring fill
#nucleotides sel fill
#trans sel 20 target f

# hydrogenase specific settings
sel @Ni,Fe,Mg
show sel a
style sel sphere
sel :cys
show sel a
col sel byhet
sel pbonds
col sel black
show :SF4
sel @Fe,Fe1,Fe2,Fe3,Fe4
style sel sphere

# hide hydrogens
hide H

# make cute cartoon style
car style helix width 2.5 thickness 1; car style strand width 2.5 thickness 1; car style arrowScale 1.5; car style coil thickness 0.9

# chunky side chain look
# size stickRadius 0.4

# make cylinders/stubs cartoon style
# cartoon style modeh def arrows t arrowshelix f arrowscale 2 wid 2 thick 0.4 sides 12 div 20
# cartoon style protein modeh tube rad 2 sides 24 thick 0.6

# keep as final command:
select clear

