### plddt colours
# color bfactor palette '0,#c53233:50,#f4c2aa:70,#7ea1f9:90,#3b4dc1'
# baker like plddt colors
# color bfactor palette '0,#f3e79b:50,#f8a07e:70,#ce6693:90,#5c53a5'

# make cute cartoon style
# car style helix width 2.5 thickness 1; car style strand width 2.5 thickness 1; car style arrowScale 1.5; car style coil thickness 0.9
car style helix width 2.4 thickness 1; car style strand width 2.4 thickness 1; car style arrowScale 1.5; car style coil thickness 0.8

# default cartoon style
# cartoon style modeh def arrows t arrowshelix f arrowscale 2 wid 2 thick 0.4 sides 12 div 20

# chunky side chain look
# size stickRadius 0.4

# make cylinders/stubs cartoon style
# cartoon style modeh def arrows t arrowshelix f arrowscale 2 wid 2 thick 0.4 sides 12 div 20
# cartoon style protein modeh tube rad 2 sides 24 thick 0.6

## style nucleotide ligands with a ring fill
#nucleotides sel fill
#trans sel 20 target f

# hide hydrogens
hide H

# hide solvent
hide solvent

# hydrogenase specific settings
sel @Ni,Fe,Mg; show sel a; style sel sphere; sel :cys; show sel a; col sel byhet; sel pbonds; col sel black; show :SF4; sel @Fe,Fe1,Fe2,Fe3,Fe4; style sel sphere; select clear;
# sel :cys; show sel a; col sel byhet; sel pbonds; col sel black; show :SF4; sel @Fe,Fe1,Fe2,Fe3,Fe4; style sel sphere; select clear;

# style ligands/cofactors as ball and stick
sel ~protein; show sel a; style sel sphere; col sel byel

# # style ligands/cofactors as cute chunky spheres (pymol like look for cofactors)
sel ~protein; show sel a; style sel sphere; size sel atomRadius 1.5; col sel byel

# keep as final command:
select clear

# create aliases and buttons, stolen from Martin Pacesa lab page
alias cute set bgcol white; graphics sil t; graphics sil width 2; lighting soft; lighting multishadow 512; car style helix width 2.5 thickness 1; car style strand width 2.5 thickness 1; car style arrowScale 1.5; car style coil thickness 0.9; sel @Ni,Fe,Mg; show sel a; style sel sphere; sel :cys; show sel a; col sel byhet; sel pbonds; col sel black; show :SF4; sel @Fe,Fe1,Fe2,Fe3,Fe4; style sel sphere; select clear; sel ~protein; show sel a; style sel sphere; size sel atomRadius 1.5; col sel byel; hide H; hide solvent; sel clear;
# buttonpanel Shortcuts add cute_view command "cute" row 0

alias clean_light lighting soft; lighting multishadow 512
# buttonpanel Shortcuts add clean_light command "clean_light" row 0

alias color_af2 color bfactor palette '0,#c53233:50,#f4c2aa:70,#7ea1f9:90,#3b4dc1'
# buttonpanel Shortcuts add coloraf2 command "color_af2" row 0

alias color_nc rainbow palette "#1f449c:#3d65A6:#7CA1cc:#a8b6cc:#eebab4:#e57a77:#f05039"
# buttonpanel Shortcuts add colornc command "color_nc" row 1

alias color_bc surface #1-1000/A; color #1-1000/A #439089; show #1-1000/B atoms; color #1-1000/B #E18797; color #1-1000/B byhetero; cartoon style width 2.2 thick 0.6
# buttonpanel Shortcuts add colorbc command color_bc row 1

# alias rotation_movie movie record supersample 3; turn y -0.5 720; wait 720; movie stop; movie encode /home/james/Pictures/ChimeraX/movie.mp4 quality highest framerate 60
alias rotation_movie movie record supersample 3; rock; wait 136; movie stop; movie encode /home/james/Pictures/ChimeraX/movie.mp4; stop
# buttonpanel Shortcuts add rotation_movie command "rotation_movie" row 1

alias save_image save /home/james/Pictures/ChimeraX/image.png pixelSize 0.04 transparentB t supersample 5
buttonpanel Shortcuts add save_image command "quicksave_png" row 1
